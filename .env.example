# Django
SECRET_KEY=replace-this-with-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL)
DB_NAME=dqms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DATABASE_URL=

# If you want to fall back to SQLite for quick local dev, set USE_SQLITE=True
USE_SQLITE=True

# Email (SMTP, e.g. Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=DQMS <youremail@gmail.com>

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# xAI Grok
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# Site
SITE_URL=http://127.0.0.1:8000
