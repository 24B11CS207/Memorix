# ── Django Core ──────────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-strong-random-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.onrender.com

# ── Database ──────────────────────────────────────────────────────
# For Render / Railway / production: set DATABASE_URL (overrides individual vars)
DATABASE_URL=postgres://user:password@host:5432/dbname

# For local dev with SQLite (no PostgreSQL needed)
USE_SQLITE=True

# Individual PostgreSQL vars (used if DATABASE_URL is not set)
DB_NAME=dqms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Google Gemini AI (PRIMARY) ────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Azure OpenAI (OPTIONAL fallback) ─────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── xAI Grok (OPTIONAL fallback) ─────────────────────────────────
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# ── Email (OPTIONAL — uses console backend if not set in dev) ─────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Memorix <youremail@gmail.com>

# ── Site URL ──────────────────────────────────────────────────────
SITE_URL=https://yourdomain.onrender.com
